# JetBrains silent-install answer file - CLion.
# Passed as  CLion.exe /S /CONFIG="<this file>" /D=<install dir>
# Same format and same reasoning as IntelliJ\silent.config - see that file for
# why each key is set the way it is.

mode=admin

launcher64=1
launcher32=0

updatePATH=1
updateContextMenu=1

jre32=0

# C/C++ associations - CLion is the C++ IDE half of the CSE toolchain.
.c=1
.cpp=1
.h=1
.hpp=1
