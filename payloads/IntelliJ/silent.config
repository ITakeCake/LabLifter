# JetBrains silent-install answer file - IntelliJ IDEA Community Edition.
# Passed as  ideaIC.exe /S /CONFIG="<this file>" /D=<install dir>
#
# This is the vendor's documented unattended format (JetBrains ships a
# silent.config of exactly this shape inside every Windows installer; run the
# installer once by hand and look in the install dir if you need to re-derive
# it). Keys the current build does not know are ignored.
#
# mode=admin  -> machine-wide install into C:\Program Files (requires the
#                elevated context LabDeploy already runs in). The alternative,
#                mode=user, would install into the imaging tech's profile and
#                no student would ever see it - the same per-user trap the
#                Excel ToolPak card documents.
mode=admin

# Desktop/Start-Menu launcher for the 64-bit IDE. The tool's own shortcut step
# then verifies the Public Desktop icon afterwards.
launcher64=1
launcher32=0

# Put idea.bat on the system PATH.
updatePATH=1

# "Open Folder as Project" in Explorer's right-click menu. Harmless and it is
# what students expect from a lab image.
updateContextMenu=1

# Do NOT install a second JetBrains runtime - IntelliJ bundles its own JBR and
# the guide's JDK requirement is satisfied by the OpenJDK 21 card.
jre32=0

# File associations for the languages this room actually teaches.
.java=1
.kt=1
.groovy=1
